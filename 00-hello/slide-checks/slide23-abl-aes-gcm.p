DEFINE VARIABLE rKey AS RAW NO-UNDO.
DEFINE VARIABLE rIv  AS RAW NO-UNDO.
DEFINE VARIABLE rTag AS MEMPTR NO-UNDO.
DEFINE VARIABLE mPlain AS MEMPTR NO-UNDO.
DEFINE VARIABLE mEnc AS MEMPTR NO-UNDO.
DEFINE VARIABLE mDec AS MEMPTR NO-UNDO.
SECURITY-POLICY:SYMMETRIC-ENCRYPTION-ALGORITHM = "AES_GCM_256".
rKey = GENERATE-RANDOM-KEY.
rIv  = HEX-DECODE("000102030405060708090a0b").
SET-SIZE(mPlain) = 11. PUT-STRING(mPlain, 1, 11) = "PUG Amsterd".
mEnc = ENCRYPT(mPlain, rKey, rIv, "AES_GCM_256", rTag).
MESSAGE "encrypted:" GET-SIZE(mEnc) "bytes, tag:" GET-SIZE(rTag) "bytes".
mDec = DECRYPT(mEnc, rKey, rIv, "AES_GCM_256", rTag).
MESSAGE "decrypted:" GET-STRING(mDec, 1, GET-SIZE(mDec)).
PUT-BYTE(mEnc, 1) = (IF GET-BYTE(mEnc, 1) = 0 THEN 1 ELSE 0).
mDec = DECRYPT(mEnc, rKey, rIv, "AES_GCM_256", rTag).
MESSAGE "tampered -> decrypted:" GET-STRING(mDec, 1, GET-SIZE(mDec)).
CATCH e AS Progress.Lang.Error:
  MESSAGE "error:" e:GetMessage(1).
END CATCH.
